# this gateway HTTP PORT
GATEWAY_PORT=9000

# Direct checkout launches use repository-local DB, outputs, and log defaults.
# Production systemd writes its one-worker and absolute FHS paths to generated
# /etc/llm-gateway/runtime.env. Do not put these installer-owned keys in .env:
# APP_DIR, LLMGATEWAY_ENV_FILE, GATEWAY_WORKERS, GATEWAY_DB_DIR,
# GATEWAY_OUTPUTS_DIR, LLMGATEWAY_LOG_DIR, CLOAKBROWSER_CACHE_DIR,
# LLMGATEWAY_CONFIG_DIR, or any of the six *_FILENAME variables.
# The systemd migration accepts only the common dotenv/systemd NAME=value subset:
# no duplicate keys, export prefix, ${...} expansion, or line continuations.

# Process environment variables override values from this file.

# This gateway must have its own API key that clients must use to access it
# Use it in the HTTP header as "Authorization: Bearer <ThisGatewayApiKey>"
GATEWAY_API_KEY=<ThisGatewayApiKey>

# Maximum number of log files to keep (older files will be deleted)
LOG_FILE_LIMIT=15

# Maximum accepted non-accounting SQLite writes held by WriteBatcher.
WRITE_BATCHER_QUEUE_MAXSIZE=4096

# Process-wide limits for retained stream-observation chunks and SSE events.
STREAM_OBSERVATION_BUFFER_MAX_BYTES=33554432
STREAM_CHUNK_QUEUE_MAXSIZE=32
STREAM_EVENT_MAX_BYTES=1048576

# Bounded JSON response observation: one response and all in-flight responses.
JSON_RESPONSE_MAX_BYTES=8388608
JSON_RESPONSE_INFLIGHT_MAX_BYTES=33554432

# Multipart file limits and process-wide upload-processing admission.
AUDIO_UPLOAD_MAX_BYTES=33554432
IMAGE_UPLOAD_MAX_FILE_BYTES=16777216
IMAGE_UPLOAD_MAX_TOTAL_BYTES=67108864
PDF_UPLOAD_MAX_BYTES=83886080
UPLOAD_INFLIGHT_MAX_BYTES=268435456
UPLOAD_ADMISSION_TIMEOUT_SECONDS=5
AUDIO_DECODED_MAX_BYTES=100663296

# Isolated deep-research child process admission.
DEEP_RESEARCH_PROCESS_CAPACITY=1
DEEP_RESEARCH_ADMISSION_TIMEOUT_SECONDS=5

# Enable/disable logging of chat messages to the /logs folder (true/false). Safe default is false.
LOG_CHAT_ENABLED=false

# Optional debug mode for fallback investigations. When true, failed fallback warning logs
# include full request messages instead of redacting them. Enable only temporarily.
LOG_FALLBACK_FULL_MESSAGES=false

# Optional diagnostic response headers X-Routed-Via and X-Fallback-Attempts.
# Disabled by default because they expose downstream routing details.
ROUTING_DIAGNOSTIC_HEADERS=false

# Optional. When unset, CORS middleware stays disabled and same-origin UI continues to work.
# Comma-separated list of allowed origins, for example:
# CORS_ALLOW_ORIGINS=http://localhost:3000,https://app.example.com

# Optional reverse-proxy trust list. X-Forwarded-For is used only when the
# immediate peer IP matches this comma-separated list of IPs/CIDRs.
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# The default fallback provider to use when the model received is not recognized 
# by this gateway in the fallback rules.
FALLBACK_PROVIDER=openrouter

# The keys of your providers. Used in the providers
# Fill the ones you want to use or add more if you like
APIKEY_OPENROUTER=<your_openrouter_api_key>
APIKEY_REQUESTY=<your_requesty_api_key>
APIKEY_OPENAI=<your_openai_api_key>
APIKEY_NEBIUS=<your_nebius_api_key>
APIKEY_TOGETHER=<your_together_api_key>
APIKEY_KLUSTERAI=<your_klusterai_api_key>
APIKEY_GOOGLE=<your_google_api_key>

# The keys of your search providers. Used for web search and web content read
TAVILY_API_KEY=<you_tavily_api_keys_by_comma>
JINA_API_KEY=<you_jina_api_keys_by_comma>
ZAI_API_KEY=<you_z.ai_api_keys_by_comma>
PROXY_URL=<you_proxy_url>

CORS_ALLOW_ORIGINS=*
